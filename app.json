{
  "expo": {
    "name": "FOM",
    "slug": "field-operations-management",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fom",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.manishgupta.fom",
      "adaptiveIcon": {
        "backgroundColor": "#176B5D",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 176,
          "resizeMode": "contain",
          "backgroundColor": "#F7F8F6",
          "dark": {
            "backgroundColor": "#F7F8F6"
          }
        }
      ],
      "expo-secure-store",
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Field Operations Management to record voice notes."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Field Operations Management to attach photo and video evidence.",
          "cameraPermission": false,
          "microphonePermission": "Allow Field Operations Management to record voice notes."
        }
      ],
      "expo-video",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}

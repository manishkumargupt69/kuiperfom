{
  "expo": {
    "name": "SiteGuard247",
    "slug": "field-operations-management",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fom",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.manishgupta.fom",
      "adaptiveIcon": {
        "backgroundColor": "#176B5D",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 176,
          "resizeMode": "contain",
          "backgroundColor": "#F7F8F6",
          "dark": {
            "backgroundColor": "#F7F8F6"
          }
        }
      ],
      "expo-secure-store",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow SiteGuard247 to capture work evidence.",
          "microphonePermission": "Allow SiteGuard247 to record audio with work evidence videos.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Field Operations Management to record voice notes."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow SiteGuard247 to choose profile photos and attach evidence.",
          "cameraPermission": "Allow SiteGuard247 to take profile photos and capture evidence.",
          "microphonePermission": "Allow Field Operations Management to record voice notes."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow SiteGuard247 to add the current address to work and incident evidence."
        }
      ],
      "expo-video",
      "expo-asset",
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
